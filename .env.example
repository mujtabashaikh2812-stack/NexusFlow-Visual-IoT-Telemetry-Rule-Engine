# Copy this file to .env and adjust. .env is never committed (it is listed in .gitignore).
MONGODB_URI=mongodb://127.0.0.1:27017/nexusflow
NODE_ENV=development
DB_MAX_RETRIES=3
DB_BASE_DELAY_MS=100
DB_MAX_DELAY_MS=2000
DB_RECONNECT_MAX_ATTEMPTS=10
TELEMETRY_BATCH_SIZE=500
TELEMETRY_FLUSH_INTERVAL_MS=1000
TELEMETRY_MAX_QUEUE_SIZE=50000
