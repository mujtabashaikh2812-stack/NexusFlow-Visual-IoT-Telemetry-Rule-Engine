# NexusFlow Server Environment Configuration
PORT=4000
NODE_ENV=development
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# High-Velocity Telemetry Buffer Limit
MAX_TELEMETRY_BUFFER=10000

# WebSocket Ping Configuration
WS_PING_INTERVAL_MS=25000
WS_PING_TIMEOUT_MS=20000
